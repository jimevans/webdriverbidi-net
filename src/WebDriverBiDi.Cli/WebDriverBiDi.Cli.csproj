<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bidi-cli</AssemblyName>
    <RootNamespace>WebDriverBiDi.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CA2007 (ConfigureAwait) is not meaningful for an exe entry point; suppress at project level. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- Reserve space in the architecture for a future WebSocket server mode without -->
    <!-- taking the dependency until that feature is actually built.                  -->
    <!--<PackageReference Include="System.Net.WebSockets.Client" ... /> -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebDriverBiDi\WebDriverBiDi.csproj" />
    <ProjectReference Include="..\WebDriverBiDi.Client\WebDriverBiDi.Client.csproj" />
  </ItemGroup>

</Project>
